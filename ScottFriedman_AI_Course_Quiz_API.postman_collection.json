{
  "info": {
    "_postman_id": "scottfriedman-ai-course-quiz-api-v2",
    "name": "🎓 ScottFriedman — AI Course & Quiz API v2",
    "description": "Complete Postman collection for the AI-powered Course Setup & Quiz system.\n\n## AI Backend\nhttp://206.162.244.135:8000\n\n## Our Backend (Proxy)\nhttp://localhost:6210\n\n## Flow\n1. POST /api/v1/course/setup\n   → AI generates User ID, Session ID automatically\n   → AI generates course title using GPT-4.1\n   → AI generates modules in a loop\n\n2. POST /api/v1/quiz/generate\n   → AI generates 10 questions with unique Question IDs\n\n3. POST /api/v1/quiz/submit\n   → AI checks answer and saves result\n\n4. GET /api/v1/quiz/results\n   → AI returns score summary",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:6210",
      "type": "string",
      "description": "Our backend base URL"
    },
    {
      "key": "ai_url",
      "value": "http://206.162.244.135:8000",
      "type": "string",
      "description": "AI API direct base URL"
    },
    {
      "key": "unique_user_id",
      "value": "",
      "type": "string",
      "description": "Auto-filled after /course/setup — comes from AI"
    },
    {
      "key": "unique_session_id",
      "value": "",
      "type": "string",
      "description": "Auto-filled after /course/setup — comes from AI"
    },
    {
