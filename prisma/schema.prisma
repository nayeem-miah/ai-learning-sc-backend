generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------- ENUMS --------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ContentType {
  TEXT
  INTERACTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  REMINDER
  EXAM
  SYSTEM
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum CourseType {
  SEMESTER
  FULL_YEAR
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// -------- USER --------

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  profilePicture String?
  role           Role     @default(STUDENT)
  status         Status   @default(ACTIVE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  notifications  Notification[]
  studentClasses StudentClass[]

  linksFrom            UserLink[]            @relation("FromUser")
  linksTo              UserLink[]            @relation("ToUser")
  attendanceRecords    AttendanceRecord[]
  courseNameGenerators CourseNameGenerator[]
}

model UserLink {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  fromId String @db.ObjectId
  toId   String @db.ObjectId

  from User @relation("FromUser", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ToUser", fields: [toId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

model StudentProfile {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique @db.ObjectId
  gradeLevel          String
  interests           String[]
  learningPreferences String[]
  goals               String?
  currentLevel        String?
  aiUserId            String?
  user                User     @relation(fields: [userId], references: [id])
}

// -------- TEACHER PROFILE --------

model TeacherProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  expertise    String[]
  bio          String?
  subjectsType String[]
  user         User     @relation(fields: [userId], references: [id])
}

model Class {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  gradeLevel String
  status     ClassStatus @default(ACTIVE)

  // Relations
  students      StudentClass[]
  totalStudents Int            @default(0)

  // AI-generated courses linked to this class
  aiCourses CourseNameGenerator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gradeLevel]) // Grade 9 + A duplicate hobe na
}

model StudentClass {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  studentId String @db.ObjectId
  classId   String @db.ObjectId

  joinedAt DateTime @default(now())
  isActive Boolean  @default(true)

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
}

// -------- LESSON PROGRESS (NO SKIP) --------

model LessonProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String    @db.ObjectId
  lessonId    String    @db.ObjectId
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  student  User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiLesson CourseLectureGenerator @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Enrollment {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  studentId          String  @db.ObjectId
  courseId           String? @db.ObjectId
  aiCourseId         String? @db.ObjectId
  progressPercentage Float   @default(0)
  currentLessonId    String? @db.ObjectId

  student  User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  aiCourse CourseNameGenerator? @relation(fields: [aiCourseId], references: [id], onDelete: Cascade)

  @@unique([studentId, aiCourseId, courseId])
}

// -------- BADGE --------

model Badge {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  icon        String
}

model StudentBadge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  badgeId   String   @db.ObjectId
  earnedAt  DateTime @default(now())
}

// -------- NOTIFICATION --------

model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------- TEACHER INVITATION --------

model Invite {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  email      String           @unique
  token      String           @unique
  role       Role             @default(TEACHER)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  @@index([status, expiresAt])
}

model Attendance {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId   String?  @db.ObjectId
  aiCourseId String?  @db.ObjectId
  moduleId   String?  @db.ObjectId
  date       DateTime
  startTime  DateTime
  endTime    DateTime
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())

  aiCourse CourseNameGenerator?    @relation(fields: [aiCourseId], references: [id], onDelete: Cascade)
  module   CourseLectureGenerator? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  records  AttendanceRecord[]

  @@unique([courseId, moduleId, date])
}

model AttendanceRecord {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String           @db.ObjectId
  studentId    String           @db.ObjectId
  joinTime     DateTime?
  status       AttendanceStatus @default(ABSENT)

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
}

//   by ai
model UserId {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  courses     CourseNameGenerator[]
  quizAnswers QuizAnswer[]
}

model CourseNameGenerator {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uniqueSessionId String @unique
  uniqueUserId    String

  // ── Course identity (mirrors Course model)
  courseName          String
  generatedCourseName String?
  description         String? // Course.description
  subject             String
  targetGradeLevel    String
  courseLength        String
  courseType          String? // Course.courseType (SEMESTER | FULL_YEAR)

  // ── Publishing & Schedule (mirrors Course model)
  isPublished Boolean   @default(false) // Course.isPublished
  startDate   DateTime? // Course.startDate
  startTime   String? // Course.startTime
  endTime     String? // Course.endTime

  // ── Course config (mirrors AI CourseInput)
  semesterCount                Int     @default(1)
  diagnosticTestBeforeCourse   Boolean @default(false)
  retestingAllowed             Boolean @default(false)
  retestingCount               Int     @default(0)
  quizzesPerModule             Int     @default(0)
  midtermExamination           Boolean @default(false)
  finalExamination             Boolean @default(false)
  totalQuizQuestions           Int     @default(0)
  masteryRequirement           Float   @default(0)
  totalModules                 Int
  estimatedDurationMinPerClass Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations
  // Linked AI user
  user UserId @relation(fields: [uniqueUserId], references: [userId], onDelete: Cascade)

  teacherId String? @db.ObjectId
  teacher   User?   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  hasMidterm Boolean @default(false)
  hasFinal   Boolean @default(false)

  // Linked Class (optional — course may or may not be assigned to a class)
  classId String? @db.ObjectId
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  modules     CourseLectureGenerator[]
  quizzes     QuizQuestion[]
  enrollments Enrollment[]
  attendances Attendance[]
}

// -------- COURSE LECTURE GENERATOR --------
model CourseLectureGenerator {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uniqueSessionId String // FK → CourseNameGenerator.uniqueSessionId
  moduleNumber    Int
  moduleTitle     String
  introduction    String?
  studyTopics     Json? // array of topic objects from AI
  voiceData       Json? // TTS voice metadata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  course           CourseNameGenerator @relation(fields: [uniqueSessionId], references: [uniqueSessionId], onDelete: Cascade)
  quizQuestions    QuizQuestion[]
  lessonProgresses LessonProgress[]
  attendances      Attendance[]

  // Prevent duplicate module numbers per session
  @@unique([uniqueSessionId, moduleNumber])
}

// -------- QUIZ QUESTION --------
// Stores AI-generated quiz questions per session
model QuizQuestion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  questionId         String  @unique // our unique key
  originalQuestionId String? // the AI's original question_id
  uniqueSessionId    String // FK → CourseNameGenerator.uniqueSessionId
  moduleId           String?

  questionNumber Int
  questionText   String

  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String // "A" | "B" | "C" | "D"

  createdAt DateTime @default(now())

  // Relations
  course  CourseNameGenerator     @relation(fields: [uniqueSessionId], references: [uniqueSessionId], onDelete: Cascade)
  module  CourseLectureGenerator? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

// -------- QUIZ ANSWER --------

model QuizAnswer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  uniqueUserId    String // FK → UserId.userId
  uniqueSessionId String // which session
  questionId      String // FK → QuizQuestion.questionId
  selectedAnswer  String // "A" | "B" | "C" | "D"
  correctAnswer   String
  isCorrect       Boolean

  submittedAt DateTime @default(now())

  // Relations
  user     UserId       @relation(fields: [uniqueUserId], references: [userId], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)
}
