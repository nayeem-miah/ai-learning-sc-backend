// ===============================
// Prisma Schema (AI Learning App)
// ===============================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------- ENUMS --------

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ContentType {
  TEXT
  INTERACTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum NotificationType {
  REMINDER
  EXAM
  SYSTEM
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum CourseType {
  SEMESTER
  FULL_YEAR
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

// -------- USER --------

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  profilePicture String?
  role           Role     @default(STUDENT)
  status         Status   @default(ACTIVE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  notifications  Notification[]
  courses        Course[]
  studentClasses StudentClass[]

  linksFrom         UserLink[]         @relation("FromUser")
  linksTo           UserLink[]         @relation("ToUser")
  attendanceRecords AttendanceRecord[]
}

model UserLink {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  fromId String @db.ObjectId
  toId   String @db.ObjectId

  from User @relation("FromUser", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ToUser", fields: [toId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

// -------- STUDENT PROFILE --------

model StudentProfile {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @unique @db.ObjectId
  gradeLevel String

  interests           String[]
  learningPreferences String[]
  goals               String?
  currentLevel        String?

  user User @relation(fields: [userId], references: [id])
}

// -------- TEACHER PROFILE --------

model TeacherProfile {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  expertise    String[]
  bio          String?
  subjectsType String[]

  user User @relation(fields: [userId], references: [id])
}

// -------- COURSE --------

// * added nayeem
model Course {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  title       String
  subject     String
  description String?
  isPublished Boolean @default(false)

  // Schedule
  startDate     DateTime?
  startTime     String?
  endTime       String?
  // ===== Course Duration =====
  courseType    CourseType // SEMESTER | FULL_YEAR
  semesterCount Int? // only for FULL_YEAR

  quizzesPerModule   Int
  totalQuizQuestions Int
  hasMidterm         Boolean @default(false)
  hasFinal           Boolean @default(false)

  // ===== Learning Benchmarks =====
  masteryRequirement     Int // percentage (e.g. 75)
  totalModules           Int
  estimatedClassDuration Int // minutes per class

  // ===== AI / System Flags =====
  diagnosticTest   Boolean @default(false)
  retestingAllowed Boolean @default(false)
  retestingCount   Int?

  // ===== Relations =====
  teacherId String @db.ObjectId
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  modules     Module[]
  enrollments Enrollment[]

  // ===== Timestamps =====
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classId     String?      @db.ObjectId
  class       Class?       @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  lessons Lesson[]
}

